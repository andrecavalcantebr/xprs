_main = fn(args){
  println(format([20.0, [4, 15]]));
  println(string(range(3)));
  println(string(range([1, 4])));
  println(string(range([10, 0, -3])));
  println(string(fill([3, "x"])));
  println(string(at(["abcdef", [0, 2, 4]])));
  println(string(any([false, true])));
  println(string(all([true, false])));
  0;
};
